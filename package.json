{
  "name": "applyrail",
  "version": "0.1.1",
  "description": "ApplyRail is an open-source job application agent. It harvests postings, queues them, fills employer ATS forms, and reviews every form before it submits.",
  "type": "module",
  "bin": {
    "applyrail": "src/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./formfill": "./src/formfill/index.js",
    "./providers": "./src/providers/index.js",
    "./resume": "./src/resume/index.js",
    "./review": "./src/review/presubmit.js",
    "./queue": "./src/queue.js"
  },
  "files": [
    "src",
    "templates",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "scrub": "node scripts/scrub-gate.mjs",
    "example": "node examples/run-dry.mjs"
  },
  "peerDependencies": {
    "jsdom": ">=24",
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "puppeteer": "^25.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyisaiah47/applyrail.git"
  },
  "homepage": "https://applyrail.thecompound.tech",
  "bugs": {
    "url": "https://github.com/kyisaiah47/applyrail/issues"
  },
  "license": "MIT",
  "author": "Compound Labs",
  "keywords": [
    "job-application",
    "ats",
    "greenhouse",
    "lever",
    "ashby",
    "workday",
    "workable",
    "resume",
    "form-filler",
    "agent"
  ]
}
